<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>sc3plugins</id>
    <version>3.14.0</version>
    <packageSourceUrl>https://github.com/gilfuser/tidal-chocolatey</packageSourceUrl>
    <title>SuperCollider sc3-plugins</title>
    <owners>Gil Fuser</owners>
    <authors>SuperCollider Authors</authors>
    <projectUrl>https://github.com/supercollider/sc3-plugins</projectUrl>
    <licenseUrl>https://github.com/supercollider/sc3-plugins/blob/Version-3.14.0/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/supercollider/sc3-plugins</projectSourceUrl>
    <docsUrl>https://docs.supercollider.online/</docsUrl>
    <bugTrackerUrl>https://github.com/supercollider/sc3-plugins/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/supercollider/sc3-plugins/releases/tag/Version-3.14.0</releaseNotes>
    <tags>supercollider sc3-plugins tidalcycles audio</tags>
    <summary>sc3-plugins 3.14.0 x64 for SuperCollider.</summary>
    <description>Installs the official 64-bit sc3-plugins 3.14.0 release into the current user's SuperCollider Extensions directory. The asset URL and SHA-256 digest are resolved from the pinned GitHub release at install time.</description>
    <dependencies>
      <dependency id="supercollider" version="[3.14.1]" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
