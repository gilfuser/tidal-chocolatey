<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>supercollider</id>
    <version>3.14.1</version>
    <packageSourceUrl>https://github.com/gilfuser/tidal-chocolatey</packageSourceUrl>
    <title>SuperCollider for Windows</title>
    <owners>Gil Fuser</owners>
    <authors>SuperCollider Authors</authors>
    <projectUrl>https://supercollider.github.io</projectUrl>
    <licenseUrl>https://github.com/supercollider/supercollider/blob/3.14/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/supercollider/supercollider</projectSourceUrl>
    <docsUrl>https://docs.supercollider.online/</docsUrl>
    <bugTrackerUrl>https://github.com/supercollider/supercollider/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/supercollider/supercollider/releases/tag/Version-3.14.1</releaseNotes>
    <tags>supercollider audio tidalcycles</tags>
    <summary>SuperCollider 3.14.1 x64 for the TidalCycles Windows stack.</summary>
    <description>Installs the official 64-bit SuperCollider 3.14.1 Windows release. The installer URL and SHA-256 digest are obtained from the pinned GitHub release at install time; installation fails if the release asset or digest cannot be verified.</description>
    <dependencies>
      <dependency id="git" version="2.33.1" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
