<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>TidalCycles</id>
    <version>1.9.4.2</version>
    <packageSourceUrl>https://github.com/gilfuser/tidal-chocolatey/</packageSourceUrl>
    <title>TidalCycles for Windows</title>
    <owners>Alex McLean</owners>
    <authors>Alex McLean</authors>
    <projectUrl>https://tidalcycles.org</projectUrl>
    <iconUrl>https://tidalcycles.org/img/tidal.png</iconUrl>
    <licenseUrl>https://github.com/tidalcycles/Tidal/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/tidalcycles/tidal</projectSourceUrl>
    <docsUrl>https://tidalcycles.org/docs</docsUrl>
    <bugTrackerUrl>https://github.com/tidalcycles/tidal/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/gilfuser/tidal-chocolatey/blob/master/tidal/changelog.md</releaseNotes>
    <tags>tidal tidalcycles livecoding audio</tags>
    <summary>TidalCycles install for Windows.</summary>
    <description>TidalCycles (or Tidal for short) is a language for live coding patterns.
    This package installs a tested Windows stack for TidalCycles together with SuperCollider,
    sc3-plugins, SuperDirt and Pulsar. GHC and Cabal are pinned to the versions currently
    recommended by the TidalCycles Windows installation documentation.

    Tidal does not make sound itself, but is designed for use with the SuperDirt synth,
    and can control other synths over Open Sound Control or MIDI.
    </description>
  <dependencies>
    <dependency id="chocolatey" version="1.2.1"/>
    <dependency id="chocolatey-core.extension" version="1.4.0"/>
    <dependency id="git" version="2.33.1"/>
    <dependency id="supercollider" version="[3.14.1]" />
    <dependency id="sc3plugins" version="[3.14.0]"/>
    <dependency id="superdirt" version="[1.7.4]"/>
    <dependency id="msys2" version="20221216.0.0" />
    <dependency id="cabal" version="[3.10.1.0]"/>
    <dependency id="ghc" version="[9.6.1]"/>
    <dependency id="pulsar" version="1.103.0"/>
  </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
